# mudauth configuration (copy to .env and fill in).
#
# Only providers with BOTH a client id and secret set will appear in the
# login menu; Steam is the exception and needs only STEAM_API_KEY. Register
# each app's redirect URI as the value of AUTH_CALLBACK_URL (or the
# per-provider *_CALLBACK_URL override).

# Public base the player opens in a browser (behind your reverse proxy). This is
# the host root; the service serves its /auth/* routes beneath it (the game
# appends /auth/login/... and the callback is this + /auth/callback). Use the
# canonical host so provider redirects land with no extra 301 hop.
AUTH_PUBLIC_BASE=https://mud.example

# Loopback listener the MUD talks to. Never expose this to the internet.
AUTH_BIND=127.0.0.1:7700

# How many reverse proxies append to X-Forwarded-For between the browser and
# this service. The default of 1 matches the shipped nginx and Apache configs.
# Raise it only if you really do run a second proxy (a CDN in front of nginx,
# say) that appends another element -- too high a value discards the header and
# too low a value reads a hop the client could have written.
# AUTH_TRUSTED_PROXY_HOPS=1

# Default OAuth callback (must be registered with each provider).
AUTH_CALLBACK_URL=https://mud.example/auth/callback

# Shown on the browser page after sign-in, and sent as the User-Agent to providers.
AUTH_BRAND_NAME=My MUD
AUTH_USER_AGENT=MyMUD-Auth/1.0 (+https://mud.example)

# ── Providers ────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=

# Twitch (dev.twitch.tv/console/apps; the account needs 2FA to register apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# TWITCH_CALLBACK_URL=

# Facebook (developers.facebook.com; App ID / App Secret from Settings→Basic.
# The app must be Live, which requires a privacy policy URL and a data
# deletion instructions URL in the app settings.)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=

# Apple (developer.apple.com; requires the paid Developer Program).
# APPLE_CLIENT_ID is the Services ID; APPLE_CLIENT_SECRET is an ES256 JWT you
# generate with `mudauth apple-secret` -- it expires within 6 months, so
# rotate it. Apple only accepts https return URLs (no local-dev callback).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# APPLE_CALLBACK_URL=

# Steam (steamcommunity.com/dev/apikey; OpenID 2.0, so no client id/secret --
# just the Web API key, used only for the persona-name lookup)
STEAM_API_KEY=
# STEAM_CALLBACK_URL=
